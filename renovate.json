{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard"
  ],
  "enabledManagers": [
    "gomod",
    "devbox",
    "github-actions",
    "custom.regex"
  ],
  "ignorePaths": [
    "content/**",
    "docs/**",
    "openspec/**"
  ],
  "semanticCommits": "enabled",
  "automerge": false,
  "timezone": "Europe/Stockholm",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Release-please configuration schema",
      "managerFilePatterns": ["/^release-please-config\\.json$/"],
      "matchStrings": ["googleapis/release-please/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/schemas/config\\.json"],
      "depNameTemplate": "googleapis/release-please",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Keep each test chart's version and archive checksum together (Kyverno, cert-manager)",
      "managerFilePatterns": [
        "/^scripts/runtime\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=helm depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\nKONSTAPEL_KYVERNO_CHART_VERSION=(?<currentValue>\\S+)\\nKONSTAPEL_KYVERNO_CHART_SHA256=(?<currentDigest>[a-f0-9]{64})",
        "# renovate: datasource=helm depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\nKONSTAPEL_CERT_MANAGER_CHART_VERSION=(?<currentValue>\\S+)\\nKONSTAPEL_CERT_MANAGER_CHART_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Prometheus Operator release whose CRDs the chart tests validate against; refresh the vendored CRDs with scripts/fetch-operator-crds.sh --refresh",
      "managerFilePatterns": [
        "/^scripts/runtime\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=(?<depName>\\S+)\\nKONSTAPEL_PROMETHEUS_OPERATOR_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Digest-pinned disposable cluster and workload images",
      "managerFilePatterns": [
        "/^scripts/runtime\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker\\nKONSTAPEL_[A-Z_]+_IMAGE=(?<depName>[^\\s@]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Keep the Devbox schema and CI installer version together",
      "managerFilePatterns": [
        "/^devbox\\.json$/",
        "/^\\.github/actions/setup-tools/action\\.yml$/"
      ],
      "matchStrings": [
        "jetify-com/devbox/(?<currentValue>\\d+\\.\\d+\\.\\d+)/\\.schema/",
        "devbox-version:\\s*['\"](?<currentValue>\\d+\\.\\d+\\.\\d+)['\"]"
      ],
      "depNameTemplate": "jetify-com/devbox",
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Go modules",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "devbox"
      ],
      "groupName": "development tools",
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "devbox"
      ],
      "matchDepNames": [
        "bashInteractive"
      ],
      "description": "Renovate's Devbox manager rejects Bash patch-level versions during extraction; update this pin and lock manually",
      "enabled": false
    },
    {
      "matchManagers": [
        "gomod",
        "devbox"
      ],
      "matchDepNames": [
        "go",
        "golang"
      ],
      "groupName": "Go toolchain",
      "rangeStrategy": "bump",
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "github.com/oscal-compass/compliance-to-policy-go/v2"
      ],
      "groupName": "C2P integration",
      "dependencyDashboardApproval": true
    },
    {
      "matchDepNames": [
        "kyverno"
      ],
      "matchManagers": [
        "devbox",
        "custom.regex"
      ],
      "groupName": "Kyverno runtime",
      "dependencyDashboardApproval": true,
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "matchDepNames": [
        "kind",
        "kubectl",
        "kubernetes-helm",
        "kyverno-chainsaw",
        "kindest/node",
        "docker.io/library/busybox"
      ],
      "matchManagers": [
        "devbox",
        "custom.regex"
      ],
      "groupName": "Kubernetes test environment",
      "dependencyDashboardApproval": true,
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "matchDepNames": [
        "jetify-com/devbox"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "Devbox",
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "gomod",
        "devbox"
      ],
      "matchDepNames": [
        "go",
        "golang"
      ],
      "description": "Temporary: Devbox's package index stops at Go 1.27.3, so hold the go.mod directive and the devbox.json pin there (they already share the Go toolchain group). Remove together with the go-licenses holds below when Devbox indexes Go 1.27.4",
      "allowedVersions": "<1.27.4"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "golang.org/x/crypto"
      ],
      "description": "Temporary (Go toolchain hold): x/crypto v0.58.0+ ships ssh/mldsa.go importing crypto/mldsa, which the Go 1.26-built Devbox go-licenses cannot load (task image:build fails); v0.59.0 also fails on Go 1.27.3. See docs/development.md 'Temporary Go toolchain holds'",
      "allowedVersions": "<0.58.0"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "github.com/sigstore/sigstore"
      ],
      "description": "Temporary (Go toolchain hold): v1.11.0+ imports crypto/mldsa in pkg/cryptoutils; same go-licenses failure",
      "allowedVersions": "<1.11.0"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "github.com/sigstore/sigstore-go"
      ],
      "description": "Temporary (Go toolchain hold): sigstore-go v1.4.0 requires rekor v1.5.5, which requires trillian v1.8.0, but task deps:check pins both Trillian images to the go.sum version (v1.7.3); hold until the Trillian images move to v1.8.0 with live acceptance",
      "allowedVersions": "<1.4.0"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "github.com/sigstore/rekor"
      ],
      "description": "Temporary (Go toolchain hold): rekor v1.5.5 requires trillian v1.8.0 (coupled to sigstore-go v1.4.0; see that hold)",
      "allowedVersions": "<=1.5.3"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "github.com/sigstore/rekor-tiles/v2"
      ],
      "description": "Temporary (Go toolchain hold): rekor-tiles v2.4.0 is coupled to sigstore-go v1.4.0 and rekor v1.5.5 (see the sigstore-go hold)",
      "allowedVersions": "<2.4.0"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "github.com/sigstore/timestamp-authority/v2"
      ],
      "description": "Temporary (Go toolchain hold): timestamp-authority v2.2.0 is coupled to sigstore-go v1.4.0 and rekor v1.5.5 (see the sigstore-go hold)",
      "allowedVersions": "<2.2.0"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "github.com/prometheus/common"
      ],
      "description": "Temporary (Go toolchain hold): v0.74.0 requires x/net v0.62, which requires x/crypto v0.58 (see the x/crypto hold)",
      "allowedVersions": "<0.74.0"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "golang.org/x/net"
      ],
      "description": "Temporary (Go toolchain hold): x/net v0.61.0+ requires x/crypto v0.58.0 (see the x/crypto hold)",
      "allowedVersions": "<0.61.0"
    },
    {
      "matchDepNames": [
        "ghcr.io/sigstore/rekor/rekor-server"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "description": "Upstream publishes bogus v99.x test tags; follow only the real v1 release series",
      "allowedVersions": "/^v1\\./"
    },
    {
      "matchDepNames": [
        "docker.io/library/postgres"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "description": "The Sigstore test stack keeps PGDATA on tmpfs and was verified on PostgreSQL 17 (18 changed the data directory layout); raising the major requires re-running the opt-in stack suite",
      "allowedVersions": "/^17\\..*-alpine$/"
    },
    {
      "matchDepNames": [
        "ghcr.io/sigstore/scaffolding/trillian_log_server",
        "ghcr.io/sigstore/scaffolding/trillian_log_signer"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "description": "Image tags must equal the github.com/google/trillian version in go.sum (task deps:check), but that module is transitive and absent from go.mod so Renovate cannot group it; bump module, both images and run the stack suite manually",
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  }
}
