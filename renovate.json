{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard"
  ],
  "enabledManagers": [
    "gomod",
    "devbox",
    "github-actions",
    "custom.regex"
  ],
  "ignorePaths": [
    "content/**",
    "docs/**",
    "openspec/**"
  ],
  "semanticCommits": "enabled",
  "automerge": false,
  "timezone": "Europe/Stockholm",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Release-please configuration schema",
      "managerFilePatterns": ["/^release-please-config\\.json$/"],
      "matchStrings": ["googleapis/release-please/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/schemas/config\\.json"],
      "depNameTemplate": "googleapis/release-please",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Keep each test chart's version and archive checksum together (Kyverno, cert-manager)",
      "managerFilePatterns": [
        "/^scripts/runtime\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=helm depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\nKONSTAPEL_KYVERNO_CHART_VERSION=(?<currentValue>\\S+)\\nKONSTAPEL_KYVERNO_CHART_SHA256=(?<currentDigest>[a-f0-9]{64})",
        "# renovate: datasource=helm depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\nKONSTAPEL_CERT_MANAGER_CHART_VERSION=(?<currentValue>\\S+)\\nKONSTAPEL_CERT_MANAGER_CHART_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Digest-pinned disposable cluster and workload images",
      "managerFilePatterns": [
        "/^scripts/runtime\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker\\nKONSTAPEL_[A-Z_]+_IMAGE=(?<depName>[^\\s@]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Keep the Devbox schema and CI installer version together",
      "managerFilePatterns": [
        "/^devbox\\.json$/",
        "/^\\.github/actions/setup-tools/action\\.yml$/"
      ],
      "matchStrings": [
        "jetify-com/devbox/(?<currentValue>\\d+\\.\\d+\\.\\d+)/\\.schema/",
        "devbox-version:\\s*['\"](?<currentValue>\\d+\\.\\d+\\.\\d+)['\"]"
      ],
      "depNameTemplate": "jetify-com/devbox",
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Go modules",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "devbox"
      ],
      "groupName": "development tools",
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "devbox"
      ],
      "matchDepNames": [
        "bashInteractive"
      ],
      "description": "Renovate's Devbox manager rejects Bash patch-level versions during extraction; update this pin and lock manually",
      "enabled": false
    },
    {
      "matchManagers": [
        "gomod",
        "devbox"
      ],
      "matchDepNames": [
        "go",
        "golang"
      ],
      "groupName": "Go toolchain",
      "rangeStrategy": "bump",
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "github.com/oscal-compass/compliance-to-policy-go/v2"
      ],
      "groupName": "C2P integration",
      "dependencyDashboardApproval": true
    },
    {
      "matchDepNames": [
        "kyverno"
      ],
      "matchManagers": [
        "devbox",
        "custom.regex"
      ],
      "groupName": "Kyverno runtime",
      "dependencyDashboardApproval": true,
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "matchDepNames": [
        "kind",
        "kubectl",
        "kubernetes-helm",
        "kyverno-chainsaw",
        "kindest/node",
        "docker.io/library/busybox"
      ],
      "matchManagers": [
        "devbox",
        "custom.regex"
      ],
      "groupName": "Kubernetes test environment",
      "dependencyDashboardApproval": true,
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "matchDepNames": [
        "jetify-com/devbox"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "Devbox",
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "gomod",
        "devbox"
      ],
      "matchDepNames": [
        "go",
        "golang"
      ],
      "description": "Temporary: Devbox's package index stops at Go 1.27.3, so hold the go.mod directive and the devbox.json pin there (they already share the Go toolchain group). Remove together with the golang.org/x/crypto rule when Devbox indexes Go 1.27.4",
      "allowedVersions": "<1.27.4"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "golang.org/x/crypto"
      ],
      "description": "Temporary: x/crypto v0.59.0 imports crypto/mldsa, absent from Go 1.27.3. Remove with the Go toolchain hold when Devbox indexes Go 1.27.4, then bump toolchain and x/crypto in one PR",
      "allowedVersions": "<0.59.0"
    },
    {
      "matchDepNames": [
        "ghcr.io/sigstore/rekor/rekor-server"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "description": "Upstream publishes bogus v99.x test tags; follow only the real v1 release series",
      "allowedVersions": "/^v1\\./"
    },
    {
      "matchDepNames": [
        "docker.io/library/postgres"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "description": "The Sigstore test stack keeps PGDATA on tmpfs and was verified on PostgreSQL 17 (18 changed the data directory layout); raising the major requires re-running the opt-in stack suite",
      "allowedVersions": "/^17\\..*-alpine$/"
    },
    {
      "matchDepNames": [
        "ghcr.io/sigstore/scaffolding/trillian_log_server",
        "ghcr.io/sigstore/scaffolding/trillian_log_signer"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "description": "Image tags must equal the github.com/google/trillian version in go.sum (task deps:check), but that module is transitive and absent from go.mod so Renovate cannot group it; bump module, both images and run the stack suite manually",
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  }
}
