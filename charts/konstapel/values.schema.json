{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "konstapel values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "replicaCount",
    "tls",
    "podDisruptionBudget",
    "controller",
    "download"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9._/-]*[a-z0-9])?(:[0-9]+)?(/[a-z0-9._-]+)*$"
        },
        "digest": {
          "description": "Image digest; empty only in unpublished source charts. Mutable tags are not accepted.",
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "description": "Serving replicas; 2 by default, 1 only for development.",
      "type": "integer",
      "minimum": 1
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "certManager",
            "secret"
          ]
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerRef": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "kind"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "Issuer",
                    "ClusterIssuer"
                  ]
                },
                "group": {
                  "const": "cert-manager.io"
                }
              }
            }
          }
        },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "certManager"
            }
          },
          "not": {
            "required": [
              "secret"
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "secret"
            }
          },
          "required": [
            "secret"
          ],
          "not": {
            "required": [
              "certManager"
            ]
          }
        }
      ]
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minAvailable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shutdownTimeoutSeconds",
        "terminationGracePeriodSeconds",
        "stagingSizeLimit"
      ],
      "properties": {
        "shutdownTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 2
        },
        "stagingSizeLimit": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"
        },
        "resources": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "bundles": {
      "description": "Verified OCI policy bundles; off while sourcesConfigMap is empty.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcesConfigMap",
        "cache",
        "refreshInterval",
        "referencedSecrets",
        "referencedConfigMaps"
      ],
      "properties": {
        "sourcesConfigMap": {
          "description": "Central sources ConfigMap in the release namespace; empty disables OCI bundles.",
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capacity",
            "sizeLimit"
          ],
          "properties": {
            "capacity": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi)$"
            },
            "sizeLimit": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi)$"
            }
          }
        },
        "refreshInterval": {
          "description": "Go duration in whole seconds or minutes, at most 5m.",
          "type": "string",
          "pattern": "^[1-9][0-9]*(s|m)$"
        },
        "referencedSecrets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        },
        "referencedConfigMaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicaCount",
        "audience",
        "maxConcurrent",
        "maxTempBytes",
        "tempSizeLimit",
        "shutdownDrainSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1
        },
        "maxTempBytes": {
          "type": "integer",
          "minimum": 1
        },
        "tempSizeLimit": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"
        },
        "shutdownDrainSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "readers",
        "tls"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "readers": {
          "description": "Monitoring ServiceAccounts bound to konstapel-metrics-reader (get /metrics). Explicit names only.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "name"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
              }
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
            }
          }
        }
      }
    }
  }
}
