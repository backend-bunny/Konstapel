{
  "convention": {
    "windows": "A Pod or template with spec.os.name: windows is outside the bundle scope: every validation short-circuits through variables.isWindowsPod. Assessment must record it as out of scope, never as passing Linux coverage (task 4.5).",
    "omittedOs": "A Pod or template without spec.os.name is evaluated with the Linux rules. This is a configuration convention; it does not attest the observed node OS.",
    "templates": "variables.podSpec extracts CronJob jobTemplate, controller template and Pod specs, so the convention applies to every matched workload form."
  },
