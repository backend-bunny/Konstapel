{
  "component-definition": {
    "uuid": "3d029a99-da25-5e9e-a09d-84916df26d1d",
    "metadata": {
      "title": "Konstapel Linux workload hardening bundle, single-validation checks",
      "last-modified": "2026-11-26T00:00:00Z",
      "version": "2.0.0",
      "oscal-version": "1.1.3",
      "remarks": "Revision of content/linux-hardening/component-definition.json (1.0.0) in which disallow-capabilities-strict and restrict-seccomp-strict are replaced by one single-validation check per original validation (content/linux-hardening/split/variants.json records the identity mapping). Each replacement keeps its original check's statements; the other checks are unchanged. Composes with content/component-definition.json (disallow-privileged-containers) by reference; it does not copy that check."
    },
    "components": [
      {
        "uuid": "6ab08f4c-b4a7-5832-a001-aab045f3ec9c",
        "type": "software",
        "title": "Kubernetes workloads",
        "description": "Linux workload configuration checks: partial, configuration-level technical evidence for AC-6, CM-6 and CM-7. No check, alone or combined, establishes full control or Moderate-baseline satisfaction.",
        "props": [
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "disallow-privilege-escalation",
            "remarks": "rule_set_0"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "Partial AC-6 and CM-6 technical evidence: requires every container to declare allowPrivilegeEscalation false, a declared privilege and configuration restriction. Does not observe privilege transitions at runtime, assess authorization or organizational procedures, or establish full AC-6/CM-6/Moderate satisfaction.",
            "remarks": "rule_set_0"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "require-drop-all-capabilities",
            "remarks": "rule_set_1"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "Partial AC-6, CM-7 and CM-6 technical evidence: requires every container to drop ALL Linux capabilities in its declared capability list. Split from disallow-capabilities-strict validation 0 with an unchanged expression. Does not observe effective process privileges or capability sets, and does not establish full AC-6/CM-7/CM-6/Moderate satisfaction.",
            "remarks": "rule_set_1"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "restrict-added-capabilities",
            "remarks": "rule_set_2"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "Partial AC-6, CM-7 and CM-6 technical evidence: requires every container to add no Linux capability other than NET_BIND_SERVICE in its declared capability list. Split from disallow-capabilities-strict validation 1 with an unchanged expression. Does not observe effective process privileges or capability sets, and does not establish full AC-6/CM-7/CM-6/Moderate satisfaction.",
            "remarks": "rule_set_2"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "require-run-as-nonroot",
            "remarks": "rule_set_3"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "Partial AC-6 and CM-6 technical evidence: requires every container to request non-root execution (runAsNonRoot true, set or inherited; user namespaces are no exemption). Does not observe the UID a process runs as, and does not establish full AC-6/CM-6/Moderate satisfaction.",
            "remarks": "rule_set_3"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "restrict-pod-seccomp-profile",
            "remarks": "rule_set_4"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "Partial CM-7 and CM-6 technical evidence: requires a Pod-level seccomp profile type, when set, to be RuntimeDefault or Localhost. Split from restrict-seccomp-strict validation 0 with an unchanged expression. Does not inspect Localhost profile contents or observe syscall filtering, and does not establish full CM-7/CM-6/Moderate satisfaction.",
            "remarks": "rule_set_4"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "require-container-seccomp-profile",
            "remarks": "rule_set_5"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "Partial CM-7 and CM-6 technical evidence: requires every container to select the RuntimeDefault or Localhost seccomp profile type, set or inherited from the Pod. Split from restrict-seccomp-strict validation 1 with an unchanged expression. Does not inspect Localhost profile contents or observe syscall filtering, and does not establish full CM-7/CM-6/Moderate satisfaction.",
            "remarks": "rule_set_5"
          }
        ],
