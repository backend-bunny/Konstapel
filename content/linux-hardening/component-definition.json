{
  "component-definition": {
    "uuid": "e5c0d7e6-ab91-5998-9b31-9690b614bd8b",
    "metadata": {
      "title": "Konstapel Linux workload hardening bundle",
      "last-modified": "2026-11-06T00:00:00Z",
      "version": "1.0.0",
      "oscal-version": "1.1.3",
      "remarks": "Composes with content/component-definition.json (disallow-privileged-containers) by reference; it does not copy that check."
    },
    "components": [
      {
        "uuid": "3a6e0b44-dfd4-5520-9d68-5b8285525a96",
        "type": "software",
        "title": "Kubernetes workloads",
        "description": "Linux workload configuration checks: partial, configuration-level technical evidence for AC-6, CM-6 and CM-7. No check, alone or combined, establishes full control or Moderate-baseline satisfaction.",
        "props": [
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "disallow-privilege-escalation",
            "remarks": "rule_set_0"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "Partial AC-6 and CM-6 technical evidence: requires every container to declare allowPrivilegeEscalation false, a declared privilege and configuration restriction. Does not observe privilege transitions at runtime, assess authorization or organizational procedures, or establish full AC-6/CM-6/Moderate satisfaction.",
            "remarks": "rule_set_0"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "disallow-capabilities-strict",
            "remarks": "rule_set_1"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "Partial AC-6, CM-7 and CM-6 technical evidence: requires every container to drop ALL Linux capabilities and add none other than NET_BIND_SERVICE in its declared capability lists. Does not observe effective process privileges or capability sets, and does not establish full AC-6/CM-7/CM-6/Moderate satisfaction.",
            "remarks": "rule_set_1"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "require-run-as-nonroot",
            "remarks": "rule_set_2"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "Partial AC-6 and CM-6 technical evidence: requires every container to request non-root execution (runAsNonRoot true, set or inherited; user namespaces are no exemption). Does not observe the UID a process runs as, and does not establish full AC-6/CM-6/Moderate satisfaction.",
            "remarks": "rule_set_2"
          },
          {
            "name": "Rule_Id",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "restrict-seccomp-strict",
            "remarks": "rule_set_3"
          },
          {
            "name": "Rule_Description",
            "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd/kubernetes",
            "value": "Partial CM-7 and CM-6 technical evidence: requires every container to select the RuntimeDefault or Localhost seccomp profile type, set or inherited. Does not inspect Localhost profile contents or observe syscall filtering, and does not establish full CM-7/CM-6/Moderate satisfaction.",
            "remarks": "rule_set_3"
          }
        ],
